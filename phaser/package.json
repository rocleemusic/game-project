{
  "name": "phaser-probe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "walk": "node tools/walk.mjs",
    "sweep": "node tools/cast-sweep.mjs",
    "gates": "node tools/gate-audit.mjs",
    "presence": "node tools/presence-audit.mjs",
    "orphans": "node tools/content-audit.mjs",
    "adversary": "node tools/adversary/run.mjs",
    "playtest": "node tools/playtest.mjs --url http://localhost:5188/?mode=mode5 --viewport 1920x1080",
    "prep:content": "node tools/bundle-content.mjs",
    "prep:assets": "node tools/prep-assets.mjs",
    "build:itch": "npm run prep:content && tsc --noEmit && vite build",
    "deploy:itch": "node tools/deploy-itch.mjs",
    "preview": "vite preview",
    "editor": "vite --config tools/content-editor/vite.config.ts",
    "screens": "node tools/screen-flow/capture.mjs && node tools/screen-flow/build-flow.mjs"
  },
  "dependencies": {
    "inkjs": "^2.4.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "playwright-core": "^1.62.1",
    "sharp": "^0.34.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "sharp@0.34.5": true
  }
}
